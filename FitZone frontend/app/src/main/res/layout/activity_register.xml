<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_xl"
        android:paddingBottom="@dimen/spacing_xl">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_logo_dumbbell"
            android:layout_marginBottom="8dp"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.FitZone.Heading1"
            android:layout_marginBottom="@dimen/spacing_xl" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Your Account"
            android:textAppearance="@style/TextAppearance.FitZone.Heading2"
            android:layout_marginBottom="8dp" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join us and start your fitness journey"
            android:textAppearance="@style/TextAppearance.FitZone.BodySecondary"
            android:layout_marginBottom="@dimen/spacing_xl" />

        <TextView
            android:id="@+id/textProgramBanner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FitZone.Body"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_md"
            tools:ignore="MissingConstraints" />

        <!-- ==================== PERSONAL DETAILS ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Personal Details"
            android:textAppearance="@style/TextAppearance.FitZone.Heading2"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutFullName" style="@style/Widget.FitZone.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Full Name" android:layout_marginBottom="@dimen/spacing_sm"
            app:startIconDrawable="@drawable/ic_profile"
            app:startIconTint="@color/colorTextSecondary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputFullName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutEmail" style="@style/Widget.FitZone.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Email" android:layout_marginBottom="@dimen/spacing_sm"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="@color/colorTextSecondary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutMobile" style="@style/Widget.FitZone.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Mobile Number" android:layout_marginBottom="@dimen/spacing_sm">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputMobile"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPassword" style="@style/Widget.FitZone.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Password" app:passwordToggleEnabled="true"
            app:passwordToggleDrawable="@drawable/ic_visibility"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:startIconDrawable="@android:drawable/ic_lock_lock"
            app:startIconTint="@color/colorTextSecondary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutConfirmPassword" style="@style/Widget.FitZone.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Confirm Password" app:passwordToggleEnabled="true"
            app:passwordToggleDrawable="@drawable/ic_visibility"
            android:layout_marginBottom="@dimen/spacing_sm"
            app:startIconDrawable="@android:drawable/ic_lock_lock"
            app:startIconTint="@color/colorTextSecondary">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputConfirmPassword"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDob" style="@style/Widget.FitZone.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Date of Birth" android:layout_marginBottom="@dimen/spacing_sm">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputDob"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:focusable="false" android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Gender" android:textAppearance="@style/TextAppearance.FitZone.Body" />
        <RadioGroup
            android:id="@+id/radioGender"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/radioMale" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Male"
                android:textColor="@color/colorTextPrimary" />
            <RadioButton android:id="@+id/radioFemale" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Female"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginStart="@dimen/spacing_md" />
            <RadioButton android:id="@+id/radioOther" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Other"
                android:textColor="@color/colorTextPrimary"
                android:layout_marginStart="@dimen/spacing_md" />
        </RadioGroup>
        <TextView
            android:id="@+id/textErrorGender"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/colorError"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- ==================== FITNESS INFORMATION ==================== -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Fitness Information"
            android:textAppearance="@style/TextAppearance.FitZone.Heading2"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutHeight" style="@style/Widget.FitZone.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Height (cm)" android:layout_marginBottom="@dimen/spacing_sm">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputHeight"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutWeight" style="@style/Widget.FitZone.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Weight (kg)" android:layout_marginBottom="@dimen/spacing_sm">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputWeight"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutGoal" style="@style/Widget.FitZone.TextInputLayout"
            app:endIconMode="dropdown_menu"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Fitness Goal" android:layout_marginBottom="@dimen/spacing_md">
            <AutoCompleteTextView
                android:id="@+id/dropdownGoal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ==================== MEMBERSHIP ==================== -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Membership Plan"
            android:textAppearance="@style/TextAppearance.FitZone.Heading2"
            android:layout_marginBottom="@dimen/spacing_sm" />
        <RadioGroup
            android:id="@+id/radioPlan"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton android:id="@+id/radio1Month" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="1 Month"
                android:textColor="@color/colorTextPrimary" />
            <RadioButton android:id="@+id/radio3Months" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="3 Months"
                android:textColor="@color/colorTextPrimary" />
            <RadioButton android:id="@+id/radio6Months" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="6 Months"
                android:textColor="@color/colorTextPrimary" />
            <RadioButton android:id="@+id/radio12Months" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="12 Months"
                android:textColor="@color/colorTextPrimary" />
        </RadioGroup>
        <TextView
            android:id="@+id/textErrorPlan"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/colorError"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_md" />

        <!-- ==================== MEDICAL INFORMATION ==================== -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Medical Information"
            android:textAppearance="@style/TextAppearance.FitZone.Heading2"
            android:layout_marginBottom="@dimen/spacing_sm" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutMedicalInfo" style="@style/Widget.FitZone.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Medical Information (enter &quot;None&quot; if not applicable)"
            android:layout_marginBottom="@dimen/spacing_md">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputMedicalInfo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:inputType="textMultiLine" android:minLines="2" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ==================== EMERGENCY CONTACT ==================== -->
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Emergency Contact"
            android:textAppearance="@style/TextAppearance.FitZone.Heading2"
            android:layout_marginBottom="@dimen/spacing_sm" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutEmergencyName" style="@style/Widget.FitZone.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Emergency Contact Name" android:layout_marginBottom="@dimen/spacing_sm">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEmergencyName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:inputType="textPersonName" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutEmergencyNumber" style="@style/Widget.FitZone.TextInputLayout"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Emergency Contact Number" android:layout_marginBottom="@dimen/spacing_md">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/inputEmergencyNumber"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="@color/colorTextPrimary"
                android:inputType="phone" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ==================== TERMS ==================== -->
        <CheckBox
            android:id="@+id/checkboxTerms"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="I accept the Terms &amp; Conditions"
            android:textColor="@color/colorTextSecondary"
            android:buttonTint="@color/colorPrimary" />
        <TextView
            android:id="@+id/textErrorTerms"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/colorError"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonRegister"
            style="@style/Widget.FitZone.Button.Primary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/register_button_text"
            android:layout_marginTop="@dimen/spacing_sm"
            android:layout_marginBottom="@dimen/spacing_sm" />

        <ProgressBar
            android:id="@+id/progressRegister"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/spacing_md" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/spacing_md">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="@color/colorTextSecondary"
                android:textAppearance="@style/TextAppearance.FitZone.Body" />
                
            <TextView
                android:id="@+id/textLoginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:textAppearance="@style/TextAppearance.FitZone.Body" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>