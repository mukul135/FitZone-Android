<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardPlan"
    style="@style/Widget.FitZone.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    android:clickable="false"
    android:focusable="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top row: plan name + BEST VALUE badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPlanName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.FitZone.Heading3" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipBestValue"
                style="@style/Widget.FitZone.Badge.Success"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plan_best_value"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false" />

        </LinearLayout>

        <!-- Price + duration -->
        <TextView
            android:id="@+id/tvPlanPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textAppearance="@style/TextAppearance.FitZone.Heading2" />

        <TextView
            android:id="@+id/tvPlanDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.FitZone.BodySecondary" />

        <!-- Current plan indicator (only visible on the member's active plan) -->
        <TextView
            android:id="@+id/tvCurrentPlanLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/plan_current_label"
            android:textAppearance="@style/TextAppearance.FitZone.Caption"
            android:textColor="@color/colorPrimary"
            android:visibility="gone" />

        <!-- Join / Current Plan button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnJoinPlan"
            style="@style/Widget.FitZone.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/plan_join_button" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>