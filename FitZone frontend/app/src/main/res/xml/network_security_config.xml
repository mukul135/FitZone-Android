<?xml version="1.0" encoding="utf-8"?>
<!--
    network_security_config.xml

    WHY THIS FILE EXISTS:
    Modern Android blocks plain "http://" traffic by default (only allows
    encrypted "https://"). That's a good security default for production,
    but Flask running locally on your machine during development is plain
    http:// — so without this file, EVERY request to 10.0.2.2 fails with
    CLEARTEXT communication to 10.0.2.2 not permitted, exactly what you saw.

    This file creates a narrow exception: cleartext (http://) is allowed
    ONLY for these specific development addresses, not for the whole app.
    Any other domain (e.g. your future production HTTPS backend) is still
    required to use https:// as normal.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulator's alias for "the computer I'm running on" -->
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- Your computer's LAN IP, for testing on a real physical phone
             later (Phase 7 rule #33) — matches ApiConfig.BASE_URL_LOCAL_NETWORK -->
        <domain includeSubdomains="false">192.168.1.101</domain>
    </domain-config>
</network-security-config>